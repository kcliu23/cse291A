{
  "_comment": "Memory budget sweep: total KV context (-c) x slots (-np) x KV-cache type, at fixed K and rate. Entries with a 'tag' get their own run folder. kvq8 halves KV memory (needs flash attention); 'fa' is the f16 control with flash attention on, so kvq8 is compared only to fa. c32768_np8_kvq8 uses about the same KV memory as c16384 f16. All configs use --cache-ram 0 (host-RAM prompt cache off) so memory is exactly the budget being varied.",
  "out_root": "runs/slots",
  "workload_config": "configs/workload_mix.json",
  "n_tasks": 30,
  "server": {
    "binary": "../llama.cpp/build/bin/llama-server",
    "model": "../models/Llama-3.2-3B-Instruct-Q4_K_M.gguf",
    "ngl": 99,
    "port": 8080,
    "extra": [
      "--cache-ram",
      "0"
    ]
  },
  "server_grid": [
    {
      "ctx": 8192,
      "parallel": 1
    },
    {
      "ctx": 8192,
      "parallel": 2
    },
    {
      "ctx": 8192,
      "parallel": 4
    },
    {
      "ctx": 16384,
      "parallel": 2
    },
    {
      "ctx": 16384,
      "parallel": 4
    },
    {
      "ctx": 16384,
      "parallel": 8
    },
    {
      "ctx": 24576,
      "parallel": 4
    },
    {
      "ctx": 24576,
      "parallel": 8
    },
    {
      "ctx": 16384,
      "parallel": 4,
      "tag": "fa",
      "extra": [
        "--cache-ram",
        "0",
        "-fa",
        "on"
      ]
    },
    {
      "ctx": 16384,
      "parallel": 4,
      "tag": "kvq8",
      "extra": [
        "--cache-ram",
        "0",
        "-fa",
        "on",
        "-ctk",
        "q8_0",
        "-ctv",
        "q8_0"
      ]
    },
    {
      "ctx": 32768,
      "parallel": 8,
      "tag": "kvq8",
      "extra": [
        "--cache-ram",
        "0",
        "-fa",
        "on",
        "-ctk",
        "q8_0",
        "-ctv",
        "q8_0"
      ]
    }
  ],
  "policies": [
    "fifo"
  ],
  "k": [
    8
  ],
  "rates": [
    0.1
  ],
  "seeds": [
    0,
    1,
    2
  ],
  "task_timeout_s": 600,
  "request_timeout_s": 300,
  "warmup": 2
}