{
  "_comment": "No-reuse baseline for the prefix-reuse study: identical to sweep_cache.json but cache_prompt is off, so every request recomputes its whole prompt.",
  "out_root": "runs/cache_off",
  "workload_config": "configs/workload_mix.json",
  "n_tasks": 40,
  "cache_prompt": false,
  "server": {
    "binary": "~/llama.cpp/build/bin/llama-server",
    "model": "~/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf",
    "ngl": 99,
    "port": 8080,
    "extra": []
  },
  "server_grid": [
    {
      "ctx": 16384,
      "parallel": 4
    }
  ],
  "policies": [
    "fifo"
  ],
  "slot_policies": [
    "auto"
  ],
  "k": [
    4,
    8
  ],
  "rates": [
    0.2
  ],
  "seeds": [
    0,
    1,
    2
  ],
  "task_timeout_s": 600,
  "request_timeout_s": 300,
  "warmup": 2
