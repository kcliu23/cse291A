{
  "_comment": "Retained-context study at K=8 with 4 slots, so agents lose their slot during tool waits. Varies llama.cpp's host-RAM prompt cache (--cache-ram, MiB): 0 = off, 1024, 8192 = default; and slot choice 'auto' (server picks) vs 'pin' (each task keeps one slot). Compare cache_hit_ratio, prefill_ms_p50, latency and peak_footprint_mb. The no-reuse baseline is configs/sweep_cache_off.json.",
  "out_root": "runs/cache",
  "workload_config": "configs/workload_mix.json",
  "n_tasks": 30,
  "cache_prompt": true,
  "server": {
    "binary": "../llama.cpp/build/bin/llama-server",
    "model": "../models/Llama-3.2-3B-Instruct-Q4_K_M.gguf",
    "ngl": 99,
    "port": 8080,
    "extra": []
  },
  "server_grid": [
    {
      "ctx": 16384,
      "parallel": 4,
      "tag": "cram0",
      "extra": [
        "--cache-ram",
        "0"
      ]
    },
    {
      "ctx": 16384,
      "parallel": 4,
      "tag": "cram1024",
      "extra": [
        "--cache-ram",
        "1024"
      ]
    },
    {
      "ctx": 16384,
      "parallel": 4,
      "tag": "cram8192",
      "extra": [
        "--cache-ram",
        "8192"
      ]
    }
  ],
  "policies": [
    "fifo"
  ],
  "slot_policies": [
    "auto",
    "pin"
  ],
  "k": [
    8
  ],
  "rates": [
    0.1
  ],
  "seeds": [
    0,
    1,
    2
  ],
  "task_timeout_s": 600,
  "request_timeout_s": 300,
  "warmup": 2
}
